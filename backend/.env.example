# Variabel Environment untuk research-api
# Salin file ini menjadi .env, lalu isi nilainya.

# ID Project Google Cloud yang digunakan untuk Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Security
# Kosongkan API_KEY untuk menonaktifkan auth (tidak disarankan di prod)
API_KEY=your-super-secret-key-123

# CORS: List origin yang dibolehkan, dipisahkan koma.
# JANGAN gunakan '*' di production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
